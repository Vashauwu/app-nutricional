# Detrás del Caddy de entrada: se confía en X-Forwarded-For de redes privadas para que la API vea la IP real
# (necesario para el límite de intentos de inicio de sesión).
{
	servers {
		trusted_proxies static private_ranges
	}
}

# {$SITE_ADDRESS}: ":80" (TLS lo termina el Caddy de entrada).
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# La API vive en el mismo origen: cookies SameSite=Strict sin CORS.
	handle /api/* {
		request_body {
			max_size 16MB
		}
		reverse_proxy api:8080
	}
	handle /healthz {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		# El service worker y la configuración nunca deben quedar en caché larga.
		@nocache path /ngsw-worker.js /ngsw.json /config.js /index.html
		header @nocache Cache-Control "no-cache"
		@assets path *.js *.css *.woff2
		header @assets Cache-Control "public, max-age=31536000, immutable"
	}
}
