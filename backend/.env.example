# Copia a .env y ajusta. Nunca subas .env al repositorio.
APP_ENV=development
HTTP_ADDR=:8080
APP_TIMEZONE=America/Mexico_City
DATABASE_URL=postgres://nutri:nutri_dev@localhost:5432/nutri?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:4200
APP_BASE_URL=http://localhost:4200
# Aplica las migraciones al arrancar (solo desarrollo).
AUTO_MIGRATE=true

# Genera uno propio, p. ej.: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
PASSWORD_RESET_TTL=30m
# En desarrollo sobre http://localhost usa false; en staging/producción, true.
COOKIE_SECURE=false

MAX_UPLOAD_BYTES=10485760
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=nutri
S3_SECRET_ACCESS_KEY=nutri_dev_secret
S3_PUBLIC_BUCKET=nutri-public
S3_PRIVATE_BUCKET=nutri-private
SIGNED_URL_TTL=5m

# Correo (invitaciones y recuperación de contraseña). Cualquier proveedor SMTP: Resend, Brevo, SES, Mailgun…
# Sin SMTP_HOST los enlaces solo aparecen en el registro de la API (útil en desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Nutrición
